<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ===== Client token: read by the client for paymentMethodIdJwt ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@+id/paypal_saved_payment_method_client_token_input"
            android:text="@string/paypal_saved_payment_method_client_token_label"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/paypal_saved_payment_method_client_token_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="none"
            android:hint="@string/paypal_saved_payment_method_client_token_hint"
            android:inputType="textMultiLine|textNoSuggestions"
            android:maxLines="4"
            android:textSize="12sp" />

        <!-- ===== Amount: drives the checkout request and the Pay Later copy ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:labelFor="@+id/paypal_saved_payment_method_amount_input"
            android:text="@string/paypal_saved_payment_method_amount_label"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/paypal_saved_payment_method_amount_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="none"
            android:inputType="numberDecimal" />

        <!-- ===== Flow: maps to PayPalCheckoutRequest.userAction ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:labelFor="@+id/paypal_saved_payment_method_flow_spinner"
            android:text="@string/paypal_saved_payment_method_flow_label"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/paypal_saved_payment_method_flow_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/paypal_saved_payment_method_flow_options"
            android:spinnerMode="dropdown" />

        <!-- ===== App switch: maps to PayPalCheckoutRequest.enablePayPalAppSwitch ===== -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/paypal_saved_payment_method_app_switch_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/paypal_saved_payment_method_app_switch_label" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/paypal_saved_payment_method_load_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/paypal_saved_payment_method_load_button" />

            <Button
                android:id="@+id/paypal_saved_payment_method_style_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="@string/paypal_saved_payment_method_style_button" />
        </LinearLayout>

        <!-- ===== The component under test ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/paypal_saved_payment_method_component_label"
            android:textStyle="bold" />

        <com.braintreepayments.api.paypalsavedpaymentmethod.component.PayPalSavedPaymentMethodView
            android:id="@+id/paypal_saved_payment_method_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <!-- ===== Edit-flow result, inline so the FI refresh stays visible ===== -->
        <LinearLayout
            android:id="@+id/paypal_saved_payment_method_nonce_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/paypal_saved_payment_method_nonce_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textIsSelectable="true" />

            <Button
                android:id="@+id/paypal_saved_payment_method_nonce_clear_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/paypal_saved_payment_method_nonce_clear_button" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
