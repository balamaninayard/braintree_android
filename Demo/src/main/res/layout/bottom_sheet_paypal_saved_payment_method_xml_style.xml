<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Configure component style"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/paypal_saved_payment_method_xml_style_close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close"
                android:src="@android:drawable/ic_menu_close_clear_cancel" />
        </LinearLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/paypal_saved_payment_method_xml_style_show_logo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:checked="true"
            android:text="Show PayPal logo" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/paypal_saved_payment_method_xml_style_show_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checked="true"
            android:text="Show PayPal label" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/paypal_saved_payment_method_xml_style_show_credit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checked="true"
            android:text="Show credit messaging" />

        <EditText
            android:id="@+id/paypal_saved_payment_method_xml_style_corner_radius"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Corner radius (dp)"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/paypal_saved_payment_method_xml_style_border_width"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Border width (dp)"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Border color"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <View
                android:id="@+id/paypal_saved_payment_method_xml_style_border_color_preview"
                android:layout_width="40dp"
                android:layout_height="40dp" />
            <Button
                android:id="@+id/paypal_saved_payment_method_xml_style_border_color_pick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pick color" />
            <CheckBox
                android:id="@+id/paypal_saved_payment_method_xml_style_border_color_default"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Use default" />
        </LinearLayout>

        <EditText
            android:id="@+id/paypal_saved_payment_method_xml_style_height"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Height (dp)"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/paypal_saved_payment_method_xml_style_horizontal_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Horizontal padding (dp)"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/paypal_saved_payment_method_xml_style_vertical_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Vertical padding (dp)"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Background color"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <View
                android:id="@+id/paypal_saved_payment_method_xml_style_background_color_preview"
                android:layout_width="40dp"
                android:layout_height="40dp" />
            <Button
                android:id="@+id/paypal_saved_payment_method_xml_style_background_color_pick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pick color" />
            <CheckBox
                android:id="@+id/paypal_saved_payment_method_xml_style_background_color_default"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Use default" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Text color"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <View
                android:id="@+id/paypal_saved_payment_method_xml_style_text_color_preview"
                android:layout_width="40dp"
                android:layout_height="40dp" />
            <Button
                android:id="@+id/paypal_saved_payment_method_xml_style_text_color_pick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pick color" />
            <CheckBox
                android:id="@+id/paypal_saved_payment_method_xml_style_text_color_default"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Use default" />
        </LinearLayout>

        <EditText
            android:id="@+id/paypal_saved_payment_method_xml_style_base_font_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Base font size (sp)"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/paypal_saved_payment_method_xml_style_logo_width"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Logo width (dp)"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/paypal_saved_payment_method_xml_style_label_font_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Label font size (sp)"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/paypal_saved_payment_method_xml_style_label_margin_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Label margin start (dp)"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/paypal_saved_payment_method_xml_style_fi_text_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Funding instrument text size (sp)"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/paypal_saved_payment_method_xml_style_edit_icon_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Edit icon size (dp)"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/paypal_saved_payment_method_xml_style_fi_margin_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Funding instrument margin start (dp)"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/paypal_saved_payment_method_xml_style_credit_font_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Credit messaging font size (sp)"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Credit messaging link color"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <View
                android:id="@+id/paypal_saved_payment_method_xml_style_link_color_preview"
                android:layout_width="40dp"
                android:layout_height="40dp" />
            <Button
                android:id="@+id/paypal_saved_payment_method_xml_style_link_color_pick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pick color" />
            <CheckBox
                android:id="@+id/paypal_saved_payment_method_xml_style_link_color_default"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Use default" />
        </LinearLayout>

        <Button
            android:id="@+id/paypal_saved_payment_method_xml_style_apply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Apply &amp; reload" />

    </LinearLayout>
</ScrollView>