<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PayPalSavedPaymentMethodView"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Client Token"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/paypal_saved_payment_method_xml_client_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Paste a client token with paymentMethodIdJwt"
            android:inputType="textMultiLine"
            android:maxLines="4" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Amount"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/paypal_saved_payment_method_xml_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Flow"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/paypal_saved_payment_method_xml_flow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/paypal_saved_payment_method_flow_options"
            android:spinnerMode="dropdown" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/paypal_saved_payment_method_xml_app_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable PayPal App Switch" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/paypal_saved_payment_method_xml_load"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Load component" />

            <Button
                android:id="@+id/paypal_saved_payment_method_xml_style"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Style" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Component"
            android:textStyle="bold" />

        <com.braintreepayments.api.paypalsavedpaymentmethod.component.PayPalSavedPaymentMethodView
            android:id="@+id/paypal_saved_payment_method_xml_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>